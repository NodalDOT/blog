{
    "name": "blog",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@10.33.0",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "test": "jest",
        "lint:css": "stylelint '**/*.{scss,css}'",
        "lint:css:fix": "stylelint '**/*.{scss,css}' --fix",
        "fix:all": "pnpm run lint:fix && pnpm run lint:css:fix && pnpm run format:fix",
        "analyze": "ANALYZE=true next build --webpack",
        "prepare": "husky",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@gsap/react": "^2.1.2",
        "@mdx-js/loader": "^3.1.1",
        "@mdx-js/react": "^3.1.1",
        "@next/mdx": "16.4.6",
        "acorn": "^8.19.0",
        "gsap": "^3.15.1",
        "next": "16.4.6",
        "next-intl": "^4.15.1",
        "prismjs": "^1.30.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "remark-gfm": "^4.0.1",
        "sass": "^1.108.2",
        "swiper": "^14.4.0"
    },
    "devDependencies": {
        "@mdx-js/mdx": "^3.1.1",
        "@next/bundle-analyzer": "16.4.6",
        "@types/estree": "^1.0.10",
        "@types/jest": "^30.0.0",
        "@types/mdast": "^4.0.4",
        "@types/mdx": "^2.0.14",
        "@types/node": "^24.19.2",
        "@types/prismjs": "^1.26.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "eslint": "9.39.5",
        "eslint-config-next": "16.4.6",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "jest": "^30.5.2",
        "jiti": "^2.7.0",
        "lint-staged": "^17.6.0",
        "mdast-util-mdxjs-esm": "^2.0.1",
        "prettier": "^3.10.1",
        "stylelint": "^17.16.0",
        "stylelint-config-clean-order": "^10.0.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "ts-jest": "^29.4.15",
        "typescript": "^6.0.3"
    },
    "overrides": {
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{scss,css}": [
            "stylelint --fix",
            "prettier --write"
        ],
        "*.{js,jsx,json,md}": [
            "prettier --write"
        ]
    }
}
