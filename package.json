{
    "name": "blog",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@10.33.0",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "test": "jest",
        "lint:css": "stylelint '**/*.{scss,css}'",
        "lint:css:fix": "stylelint '**/*.{scss,css}' --fix",
        "fix:all": "pnpm run lint:fix && pnpm run lint:css:fix && pnpm run format:fix",
        "analyze": "ANALYZE=true next build --webpack",
        "prepare": "husky",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@gsap/react": "^2.1.2",
        "gray-matter": "^4.0.3",
        "gsap": "^3.13.0",
        "next": "16.3.0",
        "next-intl": "^4.3.4",
        "next-mdx-remote": "^6.0.0",
        "prismjs": "^1.30.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "remark-gfm": "^4.0.1",
        "sass": "^1.89.2",
        "swiper": "^12.0.3"
    },
    "devDependencies": {
        "@next/bundle-analyzer": "16.3.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^20",
        "@types/prismjs": "^1.26.5",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "eslint": "9.39.1",
        "eslint-config-next": "16.3.0",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "jest": "^30.0.5",
        "jiti": "^2.5.1",
        "lint-staged": "^17.3.0",
        "prettier": "^3.6.2",
        "stylelint": "^16.23.1",
        "stylelint-config-clean-order": "^7.0.0",
        "stylelint-config-standard-scss": "^15.0.1",
        "ts-jest": "^29.4.1",
        "typescript": "^5"
    },
    "overrides": {
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{scss,css}": [
            "stylelint --fix",
            "prettier --write"
        ],
        "*.{js,jsx,json,md}": [
            "prettier --write"
        ]
    }
}
